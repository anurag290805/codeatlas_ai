APP_NAME=CodeAtlas AI
DEBUG=True
ENVIRONMENT=development
API_PREFIX=/api

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0
GEMINI_MAX_TOKENS=512

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Local development default. On Render, set DATABASE_URL to the Supabase
# PostgreSQL connection string (postgres:// and postgresql:// are accepted).
DATABASE_URL=sqlite:///./codeatlas.db
REPOSITORIES_DIR=./data/repos

CHROMA_DB_PATH=./data/chroma

# Comma-separated list of origins allowed to call this API with credentials.
# MUST include the deployed frontend origin in production. For the Vercel
# frontend -> Render backend deployment:
#   CORS_ALLOWED_ORIGINS=https://codeatlas-ai-frontend.vercel.app
# Local development + deployed production default (Vite dev server and the
# deployed Vercel frontend):
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://codeatlas-ai-frontend.vercel.app
CORS_ALLOW_CREDENTIALS=True

LOG_LEVEL=INFO

# Optional custom compiled Tree-sitter grammar directory.
# Leave unset to use the grammars bundled by tree-sitter-languages.
# TREE_SITTER_LANGUAGES_DIR=./data/tree_sitter_languages
# Random 32+ character secret used to sign workspace cookies.
WORKSPACE_SESSION_SECRET=replace-with-a-random-32-character-secret
